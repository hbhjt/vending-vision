{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vending-vision.invalid/schemas/camera-maintenance/v2/responses",
  "$defs": {
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "role", "candidateId", "generation", "expiresAt"], "properties": { "id": { "type": "string", "minLength": 1 }, "role": { "enum": ["top", "front"] }, "candidateId": { "type": "string", "minLength": 1 }, "generation": { "type": "string", "minLength": 1 }, "expiresAt": { "type": "integer" } } },
    "test": { "type": "object", "additionalProperties": false, "required": ["role", "candidateId", "generation", "ok", "evidence"], "properties": { "role": { "enum": ["top", "front"] }, "candidateId": { "type": "string", "minLength": 1 }, "generation": { "type": "string", "minLength": 1 }, "ok": { "const": true }, "frame": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }, "backendObservation": { "type": "object" }, "evidence": { "$ref": "#/$defs/evidence" } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["contractVersion", "error"], "properties": { "contractVersion": { "const": "vem.vision.camera-maintenance/v2" }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } } } }
  }
}
