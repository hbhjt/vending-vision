{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vending-vision.invalid/schemas/camera-maintenance/v2/responses",
  "$defs": {
    "backendObservation": { "type": "object", "additionalProperties": false, "required": ["backend", "index", "available", "mappingState"], "properties": { "backend": { "type": "string", "minLength": 1 }, "index": { "type": ["integer", "null"], "minimum": 0 }, "available": { "type": "boolean" }, "mappingState": { "enum": ["proven", "unproven"] } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["contractVersion", "generation", "candidates", "roles"], "properties": { "contractVersion": { "const": "vem.vision.camera-maintenance/v2" }, "generation": { "type": "string", "minLength": 1 }, "candidates": { "type": "array" }, "roles": { "type": "object", "additionalProperties": false, "required": ["top", "front"], "properties": { "top": { "type": "object" }, "front": { "type": "object" } } } } },
    "refresh": { "$ref": "#/$defs/contract" },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "role", "candidateId", "generation", "expiresAt"], "properties": { "id": { "type": "string", "minLength": 1 }, "role": { "enum": ["top", "front"] }, "candidateId": { "type": "string", "minLength": 1 }, "generation": { "type": "string", "minLength": 1 }, "expiresAt": { "type": "integer" } } },
    "test": { "type": "object", "additionalProperties": false, "required": ["role", "candidateId", "generation", "ok", "evidence"], "properties": { "role": { "enum": ["top", "front"] }, "candidateId": { "type": "string", "minLength": 1 }, "generation": { "type": "string", "minLength": 1 }, "ok": { "const": true }, "frame": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }, "backendObservation": { "$ref": "#/$defs/backendObservation" }, "evidence": { "$ref": "#/$defs/evidence" } } },
    "confirm": { "type": "object", "additionalProperties": false, "required": ["role", "state", "ready", "candidateId", "backendObservation"], "properties": { "role": { "enum": ["top", "front"] }, "state": { "const": "ready" }, "ready": { "const": true }, "candidateId": { "type": "string", "minLength": 1 }, "backendObservation": { "$ref": "#/$defs/backendObservation" } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["contractVersion", "error"], "properties": { "contractVersion": { "const": "vem.vision.camera-maintenance/v2" }, "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } } } }
  }
}
