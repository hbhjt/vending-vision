{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vending-vision.invalid/schemas/camera-maintenance/v2/requests",
  "$defs": {
    "test": { "type": "object", "additionalProperties": false, "required": ["candidateId"], "properties": { "candidateId": { "type": "string", "minLength": 1 } } },
    "confirm": { "type": "object", "additionalProperties": false, "required": ["candidateId"], "properties": { "candidateId": { "type": "string", "minLength": 1 }, "testEvidenceId": { "type": "string", "minLength": 1 }, "operatorVisualConfirmation": { "type": "boolean" } }, "oneOf": [ { "required": ["testEvidenceId"] }, { "required": ["operatorVisualConfirmation"], "properties": { "operatorVisualConfirmation": { "const": true } } } ] }
  }
}
