{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vending-vision.invalid/schemas/camera-maintenance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "candidates", "roles"],
  "properties": {
    "contractVersion": { "const": "vem.vision.camera-maintenance/v1" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "front"],
      "properties": {
        "top": { "$ref": "#/$defs/roleStatus" },
        "front": { "$ref": "#/$defs/roleStatus" }
      }
    }
  },
  "$defs": {
    "backendObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "index", "available"],
      "properties": {
        "backend": { "type": "string" },
        "index": { "type": ["integer", "null"], "minimum": 0 },
        "available": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "backendObservation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "backendObservation": { "$ref": "#/$defs/backendObservation" }
      }
    },
    "roleStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "state", "ready"],
      "properties": {
        "role": { "enum": ["top", "front"] },
        "state": { "enum": ["unbound", "missing", "ambiguous", "ready"] },
        "ready": { "type": "boolean" },
        "candidateId": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "backendObservation": { "$ref": "#/$defs/backendObservation" }
      }
    }
  }
}
